pipeline {
    agent { label 'Built-in' }
    options {
        timestamps() 
    }
    environment {
        BRANCH_NAME = "${params.BRANCH}"
        RELEASE_NAME = "${params.RELEASE}" 
        DEVOPS_DIR = "devops"
    }
   
    stages {

        stage ('validation') {
            steps {
                script {
                    env.SERVICE = env.JOB_NAME.split('/')[1]
                    echo "the service is ${env.SERVICE}"
                    currentBuild.displayName = "#${currentBuild.number} | ${env.BRANCH_NAME} | ${env.RELEASE_NAME}"
                    
                    if (!(params.BRANCH?.trim() && params.RELEASE?.trim() ))
                    error(" parameters cannot be empty")
                 
                        }

                    }            
             }

        stage ('git checkout') {
            steps {
            cleanWs()

                script {
                    try {
                        sh "mkdir -p ${env.DEVOPS_DIR}"
                        dir(env.DEVOPS_DIR) {
                
                        sh " echo 'clonning APPLICATION code' "

                        git branch: 'release', credentialsId: 'NIVA-NSE-workernode-rhel7', url: 'https://github.com/kalpesh-root/NIVA-testing.git'

                        sh " echo 'clonning Devops script' "

                        git branch: 'main', credentialsId: 'NIVA-NSE-workernode-rhel7', url: 'https://github.com/kalpesh-root/devops-cicd.git'
                        
                        }

                    } catch (Exception e) {
                        error("git clone failed: ${e.message}")
                      }
                 }
            }
        }
        stage ('Code Build') {
            steps {
                dir("$WORKSPACE") {
                     sh "python3 devops/build.py" 
                    sh "pwd"
                    sh "ls -lrt"
                 
                 }

            }
        }

     }

    


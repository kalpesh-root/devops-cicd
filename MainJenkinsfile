pipeline{
    agent {label 'built-in'}
    options {
        timestamps() 
    }
    environment {
        BRANCH_NAME = "${params.BRANCH}"
        RELEASE_NAME = "${params.RELEASE}" 
        DEVOPS_DIR = "devops"
    }
 

stages {
    
    stage ("validation") {
        steps {
        cleanWs()
            script {
                env.SERVICE = env.JOB_NAME.split('/')[1]
                echo "pipeline is running for ${SERVICE}"
                currentBuild.displayName = "#${env.SERVICE}#${env.BUILD_NUMBER}#${env.RELEASE}"
                
                if (!(params.BRANCH?.trim() && params.RELEASE?.trim() ))
                error(" parameters cannot be empty")
            }

        }

    }
    
    stage ("clone Repos") {
        steps {
            script {
                try {
                dir("app") {
                    sh" echo 'cloning source code'"
                    git branch: 'release', credentialsId: 'NIVA-NSE-workernode-rhel7', url: 'https://github.com/kalpesh-root/NIVA-testing.git'
                    sh " rm -rf .git *@tmp"
            }

                dir("devops") {
                    sh " echo 'cloning devops code'"
                    git branch: 'main', credentialsId: 'NIVA-NSE-workernode-rhel7', url: 'https://github.com/kalpesh-root/devops-cicd.git'
                    sh " rm -rf .git *@tmp"
                }
             }  catch (Exception e) { 
                    error("Git clone failed: ${e.message}")

                }
            }
        }
    }

    stage ('Code Build') {
        steps {
            script {
                try {
                    dir("$WORKSPACE") {
                       load "python3 devops/build.py"
                 
                 }

              } catch (Exception e) {
                    error("Build failed: ${e.message}")

                 }
             }
        }

    }
}
post {
    always {
            archiveArtifacts allowEmptyArchive: true, artifacts: 'devops', followSymlinks: false
            cleanWs()
            
        }
    }
}    














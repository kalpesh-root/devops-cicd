pipeline{
    agent {label 'built-in'}
    options {
        timestamps() 
    }
    environment {
        BRANCH_NAME = "${params.BRANCH}"
        RELEASE_NAME = "${params.RELEASE}" 
        DEVOPS_DIR = "devops"
    }
stages {
    
    stage ("validation") {
        steps {
        cleanWs()
            script {

                env.SERVICE = env.JOB_NAME.split('/')[1]
                echo "pipeline is running for ${SERVICE}"
                
                if (!(params.BRANCH?.trim() && params.RELEASE?.trim() ))
                error(" parameters cannot be empty")

            }

        }

    }
    
    stage ("clone Repos") {
        steps {
            dir("app") {
              
                sh" echo 'cloning source code'"
                git branch: 'release', credentialsId: 'NIVA-NSE-workernode-rhel7', url: 'https://github.com/kalpesh-root/NIVA-testing.git'
            
            }

            dir("devops") {
            sh " echo 'cloning devops code'"
                git branch: 'main', credentialsId: 'NIVA-NSE-workernode-rhel7', url: 'https://github.com/kalpesh-root/devops-cicd.git'
            
            }

        }
    }

    stage ('Code Build') {
        steps {
            dir("$WORKSPACE") {
                sh "python3 devops/build.py"
                 
                 }

            }
        }

     }

post {
    always {
            cleanWs()
        }
    }
}    













